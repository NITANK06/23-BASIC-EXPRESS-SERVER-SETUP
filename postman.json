{
  "info": {
    "name": "Basic Express Server API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Home Route",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/"
      }
    },
    {
      "name": "About Route",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/about"
      }
    },
    {
      "name": "Contact GET Route",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/contact"
      }
    },
    {
      "name": "Contact POST Route",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John\",\n  \"email\": \"john@example.com\",\n  \"message\": \"Hello\"\n}"
        },
        "url": "http://localhost:3000/contact"
      }
    }
  ]
}
